# OpenAI-compatible configuration. Keep the exact base URL supplied by your provider.
# Both gpt-4.1-mini and openai/gpt-4.1-mini are accepted here.
OPENAI_MODEL=
OPENAI_ENDPOINT=
OPENAI_API_KEY=
# A saved encrypted key can still be used when OPENAI_API_KEY is empty.

# Azure OpenAI. Copy to .env and fill values ON YOUR LAPTOP, not in chat.
# LLM_MODEL is your Azure DEPLOYMENT name, or openai/MODEL for compatible Bearer routing.
# With openai/, keep AZURE_API_KEY paired with its exact AZURE_API_BASE.
LLM_MODEL=
AZURE_API_KEY=
AZURE_API_BASE=
# Accepts https://YOUR-RESOURCE.openai.azure.com or .../openai/v1/
AZURE_API_STYLE=v1
# Only needed for the older deployment-specific Azure API:
AZURE_API_VERSION=
# Explicit override; use max_tokens when required by your compatible deployment.
AI_TOKEN_PARAMETER=max_completion_tokens
AI_DAILY_TOKEN_LIMIT=12000
AI_TOTAL_DAILY_TOKEN_LIMIT=24000
AI_MONTHLY_TOKEN_LIMIT=100000
AI_TOTAL_MONTHLY_TOKEN_LIMIT=200000
# Emergency lock: 1 blocks all new AI requests, even if enabled in the UI.
AI_PAUSED=0
AI_MAX_OUTPUT_TOKENS=1200
# Non-Azure provider alternative (leave Azure variables empty):
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# Optional external integrations. Available to the local instance owner only.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
# Optional isolated React builds / Node tests. Prepare the image first.
AGENTDOCK_ENABLE_BUILDS=0
AGENTDOCK_SANDBOX_IMAGE=agentdock-builder:local
# Separate opt-in for temporary live Node backends (maximum 15 minutes).
AGENTDOCK_ENABLE_SERVERS=0
AGENTDOCK_RUNTIME_LIFETIME_MS=900000
# Additional accounts require this invitation after the first owner is created.
AGENTDOCK_REGISTRATION=invite
AGENTDOCK_INVITE_CODE=
